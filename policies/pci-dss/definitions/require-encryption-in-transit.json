{
  "properties": {
    "displayName": "Require HTTPS/TLS for all web applications",
    "description": "PCI DSS Req 4 - Protect cardholder data in transit. Web apps must enforce HTTPS only.",
    "mode": "All",
    "policyRule": {
      "if": {
        "allOf": [
          {"field": "type", "equals": "Microsoft.Web/sites"},
          {"field": "Microsoft.Web/sites/httpsOnly", "notEquals": true}
        ]
      },
      "then": {"effect": "Deny"}
    },
    "parameters": {},
    "metadata": {"category": "App Service", "complianceFramework": "PCI DSS v4.0", "controlId": "Requirement 4", "severity": "High"}
  }
}
